#let title = "Voidcontests"
#let subtitle = "Интеллектуальная система проведения соревнований по программированию с контролем честности участников"
#let authors = "А.М. Фадеев, Д.С. Дьячков, А.Г. Оганисян"
#let venue = "Самарский университет, Стартап-центр, 2026"

#set document(
  title: title + " -- защитная речь",
  author: authors,
)

#set page(
  paper: "us-letter",
  margin: (x: 0.75in, top: 0.48in, bottom: 0.35in),
)

#set text(
  font: "Iowan Old Style",
  size: 10pt,
  lang: "ru",
)

#set par(justify: true, leading: 0.16cm, spacing: 0.28cm, first-line-indent: (amount: 0.5cm, all: true))
#set list(indent: 0.4cm)

#let header_size = 14pt
#let subheader_size = 11pt

#let header(s, time: none) = block[
  #text(weight: "extrabold", size: 11pt, tracking: 0.5pt)[#upper(s)]
  #if time != none [
    #h(0.4cm)
    #text(size: 9pt, weight: "regular", style: "italic", fill: rgb("#666666"))[\~#time]
  ]
]

#let section_gap() = v(0.4cm)

// Header
#align(center)[
  #text(size: header_size, weight: "extrabold")[#title]

  #text(size: subheader_size)[Целевой тайминг доклада: 5--6 минут]
]

// === ВСТУПЛЕНИЕ ===
#header("Вступление")
- Представить проект

// === АКТУАЛЬНОСТЬ ===
#header("Актуальность")
- Найм разработчиков перестал быть надёжным
- Растёт рынок оценки навыков
- Есть разрыв между спросом и инструментами

// === ЦЕЛЬ И ЗАДАЧИ ===
#header("Цель и задачи")
- Цель: платформа честной оценки навыков

// === ПРОДУКТ ===
#header("Описание продукта")
- B2B платформа соревнований
- Найм через реальные задачи
- 4 сценария:
  - корпоративный найм
  - открытые турниры
  - брендированные соревнования
  - тренировки и комьюнити

// === НОВИЗНА ===
#header("Ключевая новизна")
- Детектор ИИ-кода из 4 сигналов:
  - динамика набора текста
  - стилевой анализ
  - нейросетевой анализ паттернов
  - контроль поведения
- F1-score 0.93
- Ложные срабатывания < 1%
- Нет полноценных аналогов

// === РЫНОК ===
#header("Рынок")
- HR-tech: ~40 млрд \$ - Оценка навыков: ~5 млрд\$
- СНГ рынок: ~8.1 млрд ₽
- 27 тыс. IT-компаний
- Рост спроса на честную оценку

// === ЦА ===
#header("Целевая аудитория")
- Ранние клиенты:
  - крупные технологические компании
- Рост:
  - аутсорс / аутстафф
- Массовый сегмент:
  - университеты и платформы обучения

// === БИЗНЕС-МОДЕЛЬ ===
#header("Бизнес-модель")
- Подписка для компаний
- Комиссия с турниров
- Брендированные соревнования
- Средний чек: ~40 тыс ₽
- LTV/CAC = 4.6
- Окупаемость ~6 месяцев

// === ФИНАНСЫ ===
#header("Финансовая модель")
- Горизонт: 5 лет
- Инвестиции: 3,8 млн ₽
- WACC: 25%
- NPV: +4,87 млн ₽
- IRR: 47.2%
- PI: 2.28
- Окупаемость: 3.4 года
- Безубыточность: 2027
- ARR 2030: 31 млн ₽

// === РИСКИ ===
#header("Риски")
- Технологический: обход ИИ → переобучение
- Регуляторный: блокчейн и данные → резервные контуры
- Кадровый: удержание команды → долевое участие 12%

// === ЗАКЛЮЧЕНИЕ ===
#header("Итог")
- Полная система честной оценки навыков
- Сильная рыночная ниша
- Рабочая технология детекции ИИ-кода
- Подтверждённая экономика проекта
- Готовность к масштабированию

// === ФИНАЛ ===
#header("Финал")
- Спасибо за внимание
- Готовы ответить на вопросы
